# ---------- Core infra ----------
# SQLite by default (zero-infra local dev): DATABASE_URL is optional; the
# client falls back to file:./sop_platform.db next to the Prisma schema.
# For PostgreSQL (Supabase or local): set provider="postgresql" in
# packages/db/prisma/schema.prisma and point DATABASE_URL at your instance.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sop_platform

# Queue driver: "memory" (zero infra, in-process) or "redis" (BullMQ).
# Defaults to memory unless REDIS_URL is set.
QUEUE_DRIVER=memory
# REDIS_URL=redis://localhost:6379

# Run pipeline workers inside the API process (only meaningful with
# QUEUE_DRIVER=memory). Otherwise run `npm run dev:worker` separately.
RUN_INLINE_WORKERS=false

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- API / web ----------
CORS_ORIGINS=*
WEB_APP_URL=http://localhost:3000
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- AI providers (Model Router) ----------
# Leave blank to run with the deterministic Mock provider (no external calls)
# -- the default for local dev and CI. Providers activate purely by key
# presence; there is no separate mode flag.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# GROK_API_KEY=
# GROK_BASE_URL=https://api.x.ai

# ---------- Trust / auto-publish (architecture doc section 20) ----------
# Deterministic auto-publish is disabled by default; review queue is the gate.
AUTO_PUBLISH_ENABLED=false

# ---------- Notifications (stub adapter in the notifications worker) ----------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=notifications@example.org
